@using Web.Models
<section class="card status-card @StatusClass"
         aria-labelledby="current-status">

    <div class="status-top">
        <span class="status-pill">
            <span class="dot" aria-hidden="true"></span>
            @StatusLabel
        </span>

        <span class="time-range">
            @($"{Report.RequestedHour:00}:00–{Report.RequestedHour + 1:00}:00")
        </span>
    </div>

    <div class="status-content">
        <div class="status-icon" aria-hidden="true">
            <svg width="36"
                 height="36"
                 viewBox="0 0 32 32"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                @if (Report.IsOutsideOperatingHours)
                {
                    <circle cx="16" cy="16" r="11"/>
                    <path d="M16 9v7l5 3"/>
                }
                else if (Report.Status == ElevatorStatus.Working)
                {
                    <path d="m8 16 5 5L24 10"/>
                }
                else if (Report.Status == ElevatorStatus.NotWorking)
                {
                    <path d="m9 9 14 14M23 9 9 23"/>
                }
                else
                {
                    <circle cx="16" cy="16" r="11"/>
                    <path d="M11 16h10"/>
                }
            </svg>
        </div>

        <div>
            <h1 id="current-status">@Title</h1>
            <p class="status-subtitle">@Subtitle</p>
        </div>
    </div>

    @if (Report.SourceHour is int reportHour)
    {
        <div class="report-summary">
            <div class="summary-label">
                <span>
                    Avisos de @($"{reportHour:00}:00")
                    a @($"{reportHour + 1:00}:00")
                </span>
                <strong>@Report.TotalCount en total</strong>
            </div>

            <div class="vote-meter" aria-hidden="true">
                @if (Report.YesCount > 0)
                {
                    <span class="yes"
                          style="@($"flex: {Report.YesCount} 1 0%; width: auto;")">
                    </span>
                }

                @if (Report.NoCount > 0)
                {
                    <span class="no"
                          style="@($"flex: {Report.NoCount} 1 0%; width: auto;")">
                    </span>
                }
            </div>

            <div class="vote-counts">
                <span>
                    <i class="mini-dot" aria-hidden="true"></i>
                    <strong>@Report.YesCount</strong> funciona
                </span>

                <span>
                    <i class="mini-dot red" aria-hidden="true"></i>
                    <strong>@Report.NoCount</strong> no funciona
                </span>
            </div>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public HourlyReportResult Report { get; set; } = default!;

    private string StatusClass =>
        Report.IsOutsideOperatingHours
            ? "status-neutral"
            : Report.Status switch
            {
                ElevatorStatus.Working => "status-working",
                ElevatorStatus.NotWorking => "status-down",
                _ => "status-unknown"
            };

    private string StatusLabel =>
        Report.IsOutsideOperatingHours
            ? "Horario de servicio"
            : Report.SourceHour is null
                ? "Sin avisos"
                : Report.IsCarriedForward
                    ? "Últimos avisos disponibles"
                    : "Avisos de esta hora";

    private string Title =>
        Report.IsOutsideOperatingHours
            ? "Fuera de horario"
            : GetStatusText(Report.Status);

    private string Subtitle =>
        Report.IsOutsideOperatingHours
            ? Report.SourceHour is null
                ? "Horario: 07:00–23:00. Sin avisos de hoy."
                : $"Horario: 07:00–23:00. Último estado conocido: {GetStatusText(Report.Status).ToLowerInvariant()}."
            : Report.SourceHour is null
                ? "Todavía no hay avisos para hoy."
                : Report.IsCarriedForward
                    ? $"Sin avisos en esta hora. Últimos avisos: {Report.SourceHour:00}:00–{Report.SourceHour + 1:00}:00."
                    : "Según los avisos de los vecinos.";

    private static string GetStatusText(ElevatorStatus status) =>
        status switch
        {
            ElevatorStatus.Working => "Funciona",
            ElevatorStatus.NotWorking => "No funciona",
            ElevatorStatus.NoMajority => "Sin mayoría",
            _ => "Sin datos"
        };

}
