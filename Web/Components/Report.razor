<section class="report-section" aria-labelledby="report-title">
    <h2 id="report-title">¿Funciona ahora?</h2>
    <p class="section-description">Comparte lo que ves y ayuda a tus vecinos.</p>
    <div class="report-buttons">
        <button class="report-button yes" type="button"
                aria-label="Sí, el ascensor funciona. Botón de muestra sin acción.">
            <svg aria-hidden="true" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 12 4 4L19 6"/>
            </svg>
            <span class="button-copy"><span class="button-title">Sí, funciona</span><span
                    class="button-detail">Todo en orden</span></span></button>
        <button class="report-button no" type="button"
                aria-label="No, el ascensor no funciona. Botón de muestra sin acción.">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round">
                <path d="m6 6 12 12M18 6 6 18"/>
            </svg>
            <span class="button-copy"><span class="button-title">No funciona</span><span
                    class="button-detail">Hay un problema</span></span></button>
    </div>
    <p class="privacy-note">Maqueta visual: los botones no envían avisos.</p>
</section>