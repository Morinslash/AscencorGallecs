<section class="report-section" aria-labelledby="report-title">
    <h2 id="report-title">¿Funciona ahora?</h2>

    <p class="section-description" id="report-description">
        @if (IsOutsideOperatingHours)
        {
            <text>
                Fuera de horario. Puedes enviar avisos de 07:00 a 23:00.
            </text>
        }
        else
        {
            <text>Comparte lo que ves y ayuda a tus vecinos.</text>
        }
    </p>

    <div class="report-buttons">
        <button class="report-button yes"
                type="button"
                disabled="@ButtonsDisabled"
                @onclick="ReportWorking"
                aria-describedby="report-description report-note">
            <svg aria-hidden="true"
                 width="23"
                 height="23"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round">
                <path d="m5 12 4 4L19 6"/>
            </svg>

            <span class="button-copy">
                <span class="button-title">Sí, funciona</span>
                <span class="button-detail">Todo en orden</span>
            </span>
        </button>

        <button class="report-button no"
                type="button"
                disabled="@ButtonsDisabled"
                @onclick="ReportNotWorking"
                aria-describedby="report-description report-note">
            <svg aria-hidden="true"
                 width="22"
                 height="22"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round">
                <path d="m6 6 12 12M18 6 6 18"/>
            </svg>

            <span class="button-copy">
                <span class="button-title">No funciona</span>
                <span class="button-detail">Hay un problema</span>
            </span>
        </button>
    </div>

    <p class="submission-feedback"
       id="report-note"
       role="status"
       aria-live="polite">
        @if (IsSubmitting)
        {
            <text>Enviando aviso…</text>
        }
        else
        {
            @FeedbackMessage
        }
    </p>
</section>

@code {
    [Parameter, EditorRequired] public bool IsOutsideOperatingHours { get; set; }

    [Parameter] public bool IsSubmitting { get; set; }

    [Parameter] public string? FeedbackMessage { get; set; }

    [Parameter] public EventCallback<bool> OnReport { get; set; }

    private bool ButtonsDisabled =>
        IsOutsideOperatingHours || IsSubmitting;

    private Task ReportWorking() =>
        OnReport.InvokeAsync(true);

    private Task ReportNotWorking() =>
        OnReport.InvokeAsync(false);

}
