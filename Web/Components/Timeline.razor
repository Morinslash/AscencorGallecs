@using Web.Models
<section class="card timeline-card" aria-labelledby="timeline-title">
    <div class="section-heading">
        <h2 id="timeline-title">Así va el día</h2>
        <span class="today-badge">Hoy</span>
    </div>

    <p class="timeline-description">
        Estado por hora · 07:00–23:00
    </p>

    <ol class="timeline" aria-label="Historial de estados por hora">
        @for (var hour = 7; hour < 23; hour++)
        {
            var isFuture = hour > CurrentHour;
            var isCurrent = hour == CurrentHour;

            var report = isFuture
                ? null
                : Reports.GetReportForHour(hour);

            var statusClass = GetStatusClass(report);

            var itemClass =
                $"hour {statusClass}" +
                (isCurrent ? " current" : "") +
                (report?.IsCarriedForward == true ? " carried" : "");

            var description = GetDescription(hour, report, isFuture);

            if (isCurrent)
            {
                description += ", hora actual";
            }

            <li @key="hour"
                class="@itemClass"
                aria-label="@description"
                title="@description">
                <span class="hour-bar" aria-hidden="true"></span>
                <span class="hour-label" aria-hidden="true">
                    @hour.ToString("00")
                </span>
            </li>
        }
    </ol>

    <div class="legend" aria-hidden="true">
        <span>
            <i class="legend-key"></i>
            Funciona
        </span>
        <span>
            <i class="legend-key down"></i>
            No funciona
        </span>
        <span>
            <i class="legend-key tied"></i>
            Sin mayoría
        </span>
        <span>
            <i class="legend-key empty"></i>
            Sin datos
        </span>
        <span>
            <i class="legend-key carried"></i>
            Estado anterior
        </span>
    </div>

    <p class="timeline-note">
        La hora actual aparece resaltada. Las franjas indican un estado
        arrastrado de una hora anterior. Las horas futuras quedan vacías.
        Información vecinal, no verificada en tiempo real.
    </p>
</section>

@code {
    [Parameter, EditorRequired]
    public DailyReports Reports { get; set; } = default!;

    [Parameter, EditorRequired]
    public int CurrentHour { get; set; }

    private static string GetStatusClass(HourlyReportResult? report) =>
        report?.Status switch
        {
            ElevatorStatus.Working => "ok",
            ElevatorStatus.NotWorking => "down",
            ElevatorStatus.NoMajority => "tied",
            _ => "empty"
        };

    private static string GetDescription(
        int hour,
        HourlyReportResult? report,
        bool isFuture)
    {
        var interval = $"{hour:00}:00–{hour + 1:00}:00";

        if (isFuture)
        {
            return $"{interval}: hora futura";
        }

        if (report is null || report.Status == ElevatorStatus.NoData)
        {
            return $"{interval}: sin datos";
        }

        var status = report.Status switch
        {
            ElevatorStatus.Working => "funciona",
            ElevatorStatus.NotWorking => "no funciona",
            ElevatorStatus.NoMajority => "sin mayoría",
            _ => "sin datos"
        };

        var source = report.IsCarriedForward
            ? $"Sin avisos en esta hora. Últimos avisos: {report.SourceHour:00}:00–{report.SourceHour + 1:00}:00."
            : "Avisos de esta hora.";

        return $"{interval}: {status}. {source} " +
               $"{report.YesCount} sí, {report.NoCount} no.";
    }
}
